{
    "name":  "domus",
    "version":  "0.1.0",
    "private":  true,
    "description":  "Domus: find a trustworthy flatmate and manage shared living. MVP on Cloudflare Workers.",
    "scripts":  {
                    "dev":  "wrangler dev --local",
                    "deploy":  "wrangler deploy",
                    "db:init":  "wrangler d1 execute domus-db --remote --file=./schema.sql",
                    "db:init:local":  "wrangler d1 execute domus-db --local --file=./schema.sql"
                },
    "devDependencies":  {
                            "wrangler":  "^4.0.0"
                        },
    "type":  "module"
}
